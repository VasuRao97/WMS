// ============================================================
// WMS MVP — Prisma Schema
// Design principle: inventory is NEVER edited directly.
// stock_movements is an append-only ledger. Current stock is
// always derived as SUM(quantity) grouped by sku + location.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// AUTH / MASTER DATA
// ------------------------------------------------------------

// SECURITY_SUPERVISOR added 2026-08-27 — same hierarchy level/creatable-by
// rules as WAREHOUSE_SUPERVISOR (a peer, not a sub-role), but a different
// surface: gate/yard duty instead of general warehouse oversight. Confirmed
// with the client as a genuinely new role tier, not a flag layered onto an
// existing one — "same level as a wh supervisor, just with different access
// permissions." See tenant.util.ts's GATE_YARD_ALWAYS_ALLOWED_ROLES and
// Company.restrictGateAccessToSecuritySupervisor for how it gates the Gate
// In/Out page.
enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  WAREHOUSE_MANAGER
  WAREHOUSE_SUPERVISOR
  SECURITY_SUPERVISOR
  OPERATOR
}

model Company {
  id         String      @id @default(uuid())
  name       String
  code       String      @unique
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  users      User[]
  warehouses Warehouse[]
  skus       Sku[]
  customers  Customer[]
  vehicles   Vehicle[]
  drivers    Driver[]

  // Outbound Gate Out can require an E-Way Bill number before it's allowed
  // to close (see VehicleGateEntry.eWayBillNo) — but not every client routes
  // E-Way Bill data through this system today (some handle it entirely in
  // their own ERP), so this is a per-company opt-in, not a hardcoded rule.
  // Defaults off; a company turns it on once ready. 2026-08-25 design
  // conversation — see CLAUDE.md's Yard & Gate section.
  requireEwayBillForOutboundGateOut Boolean @default(false)

  // When the yard is at full capacity (no free YardSlot), should Gate In be
  // hard-blocked, or just show a warning and let staff decide? Both modes
  // are wanted, toggled per company — a "yard full" warning is always
  // surfaced either way, this only controls whether it's also a hard stop.
  // Defaults off (warn-only). 2026-08-25 design conversation.
  blockGateInWhenYardFull Boolean @default(false)

  // How often the Gate Pass Number sequence resets (see GatePassSequence) —
  // configurable per company, not a fixed platform-wide rule. QUARTER means
  // financial-year quarters (Apr-Jun/Jul-Sep/Oct-Dec/Jan-Mar), not calendar
  // quarters — confirmed with the client 2026-08-25.
  gatePassResetPeriod GatePassResetPeriod @default(FINANCIAL_YEAR)

  // When on, the Gate In/Out page (and Vehicle/Driver registration, now that
  // both only live on that page) is restricted to SECURITY_SUPERVISOR and
  // above — a general WAREHOUSE_SUPERVISOR/OPERATOR loses access. Defaults
  // off (today's broad access, unchanged) since no company has any
  // SECURITY_SUPERVISOR accounts yet the moment this ships — turning it on
  // is a deliberate opt-in once those accounts actually exist, not the
  // default. 2026-08-27 design conversation.
  restrictGateAccessToSecuritySupervisor Boolean @default(false)

  // Company-wide default detention rate, ₹/24hr (2026-08-27, revised same
  // day) — the client reconsidered per-VehicleType granularity as the
  // PRIMARY input: most companies will just set one number for their whole
  // fleet ("we can ask the client to update this at the start"), not price
  // out every vehicle class individually. Vehicle/VehicleType.
  // detentionCostPerDay (added earlier the same day) are kept as optional
  // overrides for a company that DOES want to get more granular later —
  // resolution order is Vehicle -> VehicleType -> this company default
  // (YardService.tracker()). Defaults to 15000 (a placeholder the client
  // asked to ship with, "for now") so the calculation is visible
  // immediately rather than every company starting unconfigured; a
  // COMPANY_ADMIN can change or clear it from the new Company Settings
  // page (companies/).
  detentionCostPerDay Decimal? @default(15000)

  // Free-time window before detention cost starts accruing at all, in
  // hours (2026-08-27, correcting the earlier "no grace period" call —
  // "one mistake, you were right"). Cost only starts counting once a
  // vehicle's dwell exceeds this; the daily rate above then applies per
  // 24-hour period measured from the END of this window, not from Gate In
  // itself — so the full detentionCostPerDay amount is reached at
  // (detentionFreeHours + 24) hours after Gate In, not at 24. See
  // YardService.tracker() for the actual formula. Defaults to 4 — the
  // client's own placeholder ("~4 hours"), same "ships with a number,
  // adjustable later" pattern as detentionCostPerDay above.
  detentionFreeHours Int? @default(4)

  // Detention alerting — deliberately separate from the cost calculation
  // above (which has its own grace period, detentionFreeHours). These two
  // hour counts are purely about WHEN to notify someone, not about the cost
  // math at all:
  // detentionAlertHours is how long a vehicle can dwell before the first
  // alert fires; detentionEscalationHours is how much longer after that,
  // still unacknowledged, before it also goes to the Company Admin. Both
  // nullable — a company that hasn't configured them gets no alerts, not a
  // silent default threshold (unlike the cost rate above, alerting stays
  // strictly opt-in).
  detentionAlertHours      Int?
  detentionEscalationHours Int?

  notificationChannels CompanyNotificationChannel[]
  notificationLogs     NotificationLog[]
  selfCheckInRequests  SelfCheckInRequest[]

  // Whether this company's ERP can push Inbound orders directly into this
  // system (2026-08-27) — real, working now, not just a toggle: see
  // ErpInboundController/InboundReceiptsService.erpPush(). SKU/Warehouse
  // are resolved by their normal internal Code (not `erpCode` — that field
  // exists on Sku/Warehouse but is completely unwired anywhere yet, no
  // form sets it; using it here would just be a second unpopulated
  // dependency. Revisit once erpCode actually gets wired up somewhere).
  allowErpInboundPush Boolean @default(false)
  // The API key an ERP integration sends in the `X-Api-Key` header to
  // authenticate a push — this is OUR secret, issued TO an external
  // caller, the opposite direction from a third-party provider key (which
  // this codebase deliberately keeps out of the DB, see NotificationsModule's
  // comment). Nullable until a COMPANY_ADMIN generates one from Company
  // Settings; a push is rejected if unset even with allowErpInboundPush on.
  // Stored as plain text for now (no encryption-at-rest in this project
  // yet, same caveat as everywhere else secrets are mentioned) — a known,
  // flagged simplification, not an oversight.
  erpApiKey String? @unique
}

enum GatePassResetPeriod {
  FINANCIAL_YEAR
  QUARTER
  MONTH
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  passwordHash       String
  name               String
  role               Role
  // Free-text specialization label for Supervisor/Operator (e.g. "Inbound Sup",
  // "Shift Sup", "Picking") — descriptive only for now, for future KPI/task-routing
  // reporting. Not read by any permission check; the real access rules run purely
  // off `role` + `assignedWarehouses`.
  functionTag        String?
  // Contact number, added 2026-08-27 specifically so staff (Managers/
  // Admins) can actually receive SMS/WhatsApp notifications — a real gap
  // found while building detention alerting: only Driver had a phone
  // field, so a staff-facing alert could only ever go out by email. Purely
  // a contact field, no login/identity meaning — email stays the login ID
  // either way, same as before this field existed. No uniqueness
  // constraint (same reasoning as Driver.phone — not a reliable natural
  // key to enforce).
  phone              String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  // Fast "last seen" lookup — a cached/derived convenience, same relationship
  // to `LoginEvent` below as on-hand stock has to `StockMovement`: the ledger
  // (LoginEvent, append-only, one row per login, forever) is the source of
  // truth; this field is just the latest value read off it, updated
  // alongside every LoginEvent insert so the two never drift.
  lastLoginAt        DateTime?
  companyId          String?
  company            Company?     @relation(fields: [companyId], references: [id])
  assignedWarehouses Warehouse[]
  loginEvents        LoginEvent[]

  receiptsCreated       InboundReceipt[]     @relation("ReceiptCreatedBy")
  putawaysCompleted     PutawayTask[]        @relation("PutawayCompletedBy")
  ordersCreated         OutboundOrder[]      @relation("OrderCreatedBy")
  picksCompleted        PickTask[]           @relation("PickedBy")
  dispatches            Dispatch[]           @relation("DispatchedBy")
  movements             StockMovement[]      @relation("MovementCreatedBy")
  gateEntriesIn         VehicleGateEntry[]   @relation("GateInBy")
  gateEntriesOut        VehicleGateEntry[]   @relation("GateOutBy")
  gateEntriesDocked     VehicleGateEntry[]   @relation("DockedInBy")
  gateEntriesSealedBy   VehicleGateEntry[]   @relation("SealCapturedBy")
  inboundScansPerformed InboundReceiptScan[] @relation("InboundScannedBy")
  inboundScansReviewed  InboundReceiptScan[] @relation("InboundScanReviewedBy")
  inwardCompletions     VehicleGateEntry[]   @relation("InwardCompletedBy")

  notificationsReceived       NotificationLog[]    @relation("NotificationRecipient")
  notificationsEscalatedTo    NotificationLog[]    @relation("NotificationEscalatedTo")
  selfCheckInRequestsReviewed SelfCheckInRequest[] @relation("SelfCheckInReviewedBy")
}

// Append-only login ledger — one row per successful login, never updated or
// deleted, mirroring StockMovement's "never UPDATE, always INSERT" pattern.
// First-level capture only (2026-08-24): records the raw data a future
// manpower-attendance report would read (who logged in, when) — the report/
// rollup itself (days present, daily attendance view) is deliberately not
// built yet, this just makes sure the history exists to build it from later.
model LoginEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  loggedInAt DateTime @default(now())

  @@index([userId, loggedInAt])
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  erpCode   String?
  latitude  Float?
  longitude Float?

  // Network node master fields — a Warehouse row can be any node type in the
  // client's network (Factory FG, Distributor, Regional DC, National DC,
  // CNF, Cross-dock). Operational fields below are optional on every row
  // regardless of node type: a Distributor might be tracked as fully as an
  // RDC, or left as a bare reference point — client's choice per facility.
  nodeType    String? // FACTORY | DISTRIBUTOR | REGIONAL_DC | NATIONAL_DC | CNF | CROSS_DOCK
  city        String?
  pincode     String?
  threePlName String? // free text; "OWN" by convention if self-operated
  noOfDocks   Int?
  areaSqFt    Decimal? // total facility footprint, not broken down by storage type

  // Number of physical parking/yard slots at this facility (2026-08-25,
  // Yard Management design conversation) — drives how many real `YardSlot`
  // rows get generated for this warehouse (see that model's comment). Same
  // "only settable at creation" limitation as Warehouse Manager
  // (contactName/contactPhone) below, until Warehouse Edit exists.
  yardCapacity Int?

  // This facility's own GST registration — distinct from any customer's
  // gstNumber. Each warehouse is typically its own GST registration in
  // Indian operations; needed on invoices/e-way bills generated from here.
  // No format is enforced yet (unlike Customer.gstNumber's GST_REGEX) since
  // real values haven't been collected — tighten this once they have.
  gstin String?

  // Static facility facts, free text (like threePlName) — not a dispatch
  // policy. A real dispatch cutoff/appointment rule belongs to a future
  // Dispatch Policy stage once Outbound/Dispatch exist to enforce it; this
  // is just "when is someone physically here," useful on its own regardless.
  workingDays  String? // e.g. "Mon-Sat" or "24x7"
  workingHours String? // e.g. "09:00-18:00"
  contactName  String?
  contactPhone String?

  assignedUsers User[]

  shipToAssignments   CustomerShipTo[]
  locations           Location[]
  inboundReceipts     InboundReceipt[]
  outboundOrders      OutboundOrder[]
  stockMovements      StockMovement[]
  storageTypes        WarehouseStorageType[]
  dispatchFlows       WarehouseDispatchFlow[]
  dockDoors           DockDoor[]
  gateEntries         VehicleGateEntry[]
  yardSlots           YardSlot[]
  gatePassSequences   GatePassSequence[]
  notificationLogs    NotificationLog[]
  selfCheckInRequests SelfCheckInRequest[]

  @@unique([companyId, code])
}

model WarehouseStorageType {
  id              String          @id @default(uuid())
  warehouseId     String
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  storageType     String // GROUND_FLOOR | SPR | DRIVE_IN | MIX | ASRS | STILLAGE
  categoryId      String
  category        ProductCategory @relation(fields: [categoryId], references: [id])
  palletPositions Decimal
  // Bin dimensions for this (storageType, category) combo, in meters — one
  // category can need different pallet sizes in different storage types
  // (e.g. Car Tyres vs Truck Tyres, both in SPR racking), so dimensions live
  // here rather than on Warehouse or as a per-bin field on Location.
  lengthM         Decimal?
  widthM          Decimal?
  heightM         Decimal?

  // How many distinct SKUs are allowed to share one physical Location for
  // this (storageType, category) combo, tiered by the SKU's own Sku.abcClass
  // — e.g. an A-class fast-mover typically gets a bin to itself, while
  // slow-moving C-class SKUs can be co-located to use space efficiently.
  // Null means "no limit" for that class. This is a config value only —
  // nothing enforces it yet; that's Putaway/slotting logic, not built yet
  // (deliberately deferred, 2026-08-24 design pass — see CLAUDE.md).
  maxSkusClassA Int? @default(1)
  maxSkusClassB Int? @default(2)
  maxSkusClassC Int?

  @@unique([warehouseId, storageType, categoryId])
}

// Platform-level reference data for the storage-type breakdown above — NOT a
// tenant master (no companyId), and not client-editable via any UI. Seeded
// directly by us so every company's dropdown draws from the same curated
// list. Phase 1 is a flat list; an `industryId` can be added later to filter
// this per company without reshaping anything above.
model ProductCategory {
  id                String                 @id @default(uuid())
  name              String                 @unique
  storageBreakdowns WarehouseStorageType[]
  skus              Sku[]
  packSpecs         CategoryPackSpec[]
  locations         Location[]
}

// Physical dimensions of a Category's packaging at a given unit level (EACH/
// INNER/CASE/PALLET — same vocabulary as SkuStorageUnit.unitType), keyed by
// Category rather than by individual Sku: this is the repository Sku.category
// + Sku.primaryStorageUnit point into, so one correction here (e.g. Car
// Tyres' case dimensions changed) cascades to every SKU in that category
// instead of needing a per-SKU edit. Same reasoning as WarehouseStorageType's
// dimensions — assume uniformity within a category rather than track it per
// individual record. Platform-managed like ProductCategory itself; nothing
// populates real numbers here yet.
model CategoryPackSpec {
  id         String          @id @default(uuid())
  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  unitType   String
  lengthCm   Decimal?
  widthCm    Decimal?
  heightCm   Decimal?
  weightKg   Decimal?

  @@unique([categoryId, unitType])
}

model WarehouseDispatchFlow {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  flowType    String // FULL_PALLET | CASE_PICK | BROKEN_CASE
}

model Customer {
  id              String           @id @default(uuid())
  code            String
  name            String
  category        String?
  email           String?
  phone           String?
  pan             String?
  billingAddress  String?
  pincode         String?
  state           String?
  gstNumber       String?
  isActive        Boolean          @default(true)
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  erpCode         String?
  createdAt       DateTime         @default(now())
  shipToLocations CustomerShipTo[]

  @@unique([companyId, code])
}

model CustomerShipTo {
  id           String     @id @default(uuid())
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id])
  shipToCode   String?
  address      String
  pincode      String
  state        String
  gstNumber    String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean    @default(false)
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  deliveryZone String? // LOCAL | UPCOUNTRY — relative to the serving warehouse, for dispatch planning
  createdAt    DateTime   @default(now())
}

// What a Location is FOR (function), independent of how it's physically
// built (that's storageType below). Settled in the 2026-08-24 Locations/Bins
// design pass — see CLAUDE.md's "Location zone model" section for the full
// reasoning behind this list (why Forward Pick and Pick Face stay separate,
// why QC Hold/Temp-Controlled/Hazmat/Damage & Scrap were added, etc.).
enum LocationZoneType {
  UNLOADING_STAGING
  LOADING_STAGING
  ACTUAL_STORAGE
  FORWARD_PICK
  PICK_FACE
  PACKING_KITTING
  CROSS_DOCK
  SLOB
  RETURNS
  RE_PUTAWAY
  QC_HOLD
  TEMP_CONTROLLED_STORAGE
  HAZMAT
  DAMAGE_SCRAP
}

model Location {
  id          String           @id @default(uuid())
  warehouseId String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  // Auto-built display/scan code, one template per storageType — e.g.
  // "A01-R05-L02-B01" (rack), "GF-A01-BLK07" (ground), "ST-A01-04" (stillage).
  code        String
  // Named physical-area label (e.g. "Zone 1"), distinct from zoneType's
  // function tag — a zone groups aisles, zoneType says what the bin is for.
  zone        String?
  zoneType    LocationZoneType
  // How this bin is physically built. Free text (not a Postgres enum), same
  // convention as WarehouseStorageType.storageType — validated in the service
  // against GROUND_FLOOR | SPR | DRIVE_IN | ASRS | STILLAGE. Deliberately
  // excludes "MIX": that value only ever means "warehouse hasn't broken this
  // down yet" at the WarehouseStorageType (capacity-planning) level — a real,
  // physical bin is always concretely one of the five, never "mixed" itself.
  storageType String
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id])

  // Identifier fields — populate only the group matching storageType. Rack
  // (SPR/DRIVE_IN/ASRS): aisle+rack+level+bin. Ground (GROUND_FLOOR):
  // aisle+block. Stillage (STILLAGE): aisle+stack. `aisle` is the one field
  // shared by all three (every location sits along some walking aisle).
  // Manually-named physical section — one Section per Aisle, always (a hard
  // 1:1 invariant enforced in the service layer, not the DB — see
  // `assertSectionConsistency` in locations.service.ts). Distinct from
  // `zone` (a free label with no such invariant) and from the future Zone
  // grouping-of-aisles concept (a Zone will span several Aisles; a Section
  // never spans more than one). Typed by hand — real Section names are
  // often tied to something physical (a building landmark, a client's own
  // floor plan) rather than a neat sequence, so this is never auto-lettered.
  section String?

  aisle String?
  rack  String? // bay/column within the rack row
  level String? // vertical tier within the rack (1 = ground)
  bin   String? // shelf-slot within a level, for shelving/small-parts bins
  block String? // ground-floor block id (e.g. block-stacked tyre pallets)
  stack String? // stillage column id (cages stacked one on another)

  // Global, warehouse-wide flank number — "R1", "R2", "R3"... one per whole
  // flank (everything on one side of one aisle), never resetting between
  // aisles. Replaces the earlier `side` field (2026-08-25 design pass,
  // retired the same day it was added — see CLAUDE.md's Locations/Bins
  // Plan View notes): `side` only ever answered "primary or secondary
  // flank of *this* aisle" for the Plan View's split logic; `flankNumber`
  // answers that AND gives every flank a real, storable, globally unique
  // identity — needed for the future Putaway/Pick logic to reference, not
  // just for display. Within one aisle, whichever flank number is LOWER is
  // the primary/right flank, the higher one (if it exists) is secondary/
  // left — derived by comparison, not a separate flag. Allocated by
  // `LocationsService.resolveFlankNumber()`: a brand-new flank gets the
  // next available number warehouse-wide (never reused/wasted); a flank
  // that already has a number (an aisle being added to later) reuses it.
  flankNumber Int?

  // Dimensional fields — shared concept, meaning depends on storageType.
  // Rack: depth = position in a multi-deep drive-in lane (1=front..N=back).
  // Ground: depth/width = the block's footprint (e.g. 4 deep x 4 wide);
  // height = stacked layers, normally 1 (pallets rarely stack on pallets).
  // Stillage: width/depth = how many stillage columns sit side by side /
  // front-to-back; height = how many cages stacked vertically in one column.
  depth  Int?
  width  Int?
  height Int?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockMovements     StockMovement[]
  putawayFrom        PutawayTask[]        @relation("PutawayFromLocation")
  putawayTo          PutawayTask[]        @relation("PutawayToLocation")
  receiptLinesStaged InboundReceiptLine[]
  // A receipt-level default staging spot, chosen once the vehicle is
  // actually at the dock (2026-08-27 — see InboundReceipt.stagingLocationId's
  // comment for why this replaced requiring a location per-line at
  // order-creation time).
  receiptsStaged     InboundReceipt[]
  allocations        Allocation[]
  returns            Return[]
  dockDistances       DockLocationDistance[]
  defaultStagingForDocks DockDoor[]

  @@unique([warehouseId, code])
}

model Sku {
  id                 String               @id @default(uuid())
  code               String
  description        String
  categoryId         String
  category           ProductCategory      @relation(fields: [categoryId], references: [id])
  subCategory        String?
  baseUom            String
  hsnCode            String
  storageCondition   String               @default("AMBIENT")
  batchTracked       Boolean              @default(false)
  shelfLifeTracked   Boolean              @default(false)
  shelfLifeDays      Int?
  isActive           Boolean              @default(true)
  weightUom          String?
  grossWeight        Decimal?
  isHazmat           Boolean              @default(false)
  hazmatClass        String?
  hasUniqueBarcode   Boolean              @default(false)
  abcClass           String?
  currency           String?
  standardCost       Decimal?
  moq                Decimal?
  // Which of this SKU's declared storageUnits (EACH/INNER/CASE/PALLET) is
  // its primary unit for putaway/picking sizing — must match one of the
  // unitTypes in storageUnits below. Dimensions themselves aren't stored
  // here: look up CategoryPackSpec(categoryId, primaryStorageUnit) instead,
  // so a correction to "Car Tyres' case size" doesn't require editing every
  // Car Tyres SKU individually.
  primaryStorageUnit String?
  createdAt          DateTime             @default(now())
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id])
  erpCode            String?
  storageUnits       SkuStorageUnit[]
  barcodes           SkuBarcode[]
  asParent           SkuRelationship[]    @relation("ParentSku")
  asChild            SkuRelationship[]    @relation("ChildSku")
  stockMovements     StockMovement[]
  receiptLines       InboundReceiptLine[]
  inboundScans       InboundReceiptScan[]
  putawayTasks       PutawayTask[]
  outboundOrderLine  OutboundOrderLine[]
  allocations        Allocation[]
  returns            Return[]

  @@unique([companyId, code])
}

model SkuStorageUnit {
  id           String  @id @default(uuid())
  skuId        String
  sku          Sku     @relation(fields: [skuId], references: [id])
  unitType     String
  qtyInBaseUom Decimal
  isPreferred  Boolean @default(false)

  barcodes SkuBarcode[]
}

model SkuBarcode {
  id      String @id @default(uuid())
  skuId   String
  sku     Sku    @relation(fields: [skuId], references: [id])
  barcode String
  type    String

  // Which pack level this specific barcode represents — a case barcode
  // links to the CASE SkuStorageUnit row, a single-tyre barcode links to
  // EACH (or stays unset, same effective meaning). Nullable and defaults
  // to "1 each" when unset, so every barcode entered before this field
  // existed keeps working unchanged (2026-08-27, Inbound receiving design
  // — this is what lets a scan resolve its actual quantity: 12 for a case,
  // 1 for a tyre, via SkuStorageUnit.qtyInBaseUom).
  storageUnitId String?
  storageUnit   SkuStorageUnit? @relation(fields: [storageUnitId], references: [id])
}

model SkuRelationship {
  id          String  @id @default(uuid())
  parentSkuId String
  parentSku   Sku     @relation("ParentSku", fields: [parentSkuId], references: [id])
  childSkuId  String
  childSku    Sku     @relation("ChildSku", fields: [childSkuId], references: [id])
  quantity    Decimal
}

// ------------------------------------------------------------
// INVENTORY LEDGER — the single source of truth for stock
// ------------------------------------------------------------

enum MovementType {
  RECEIPT // + stock at a receiving/staging location
  PUTAWAY_OUT // - stock at staging location
  PUTAWAY_IN // + stock at storage location
  PICK // - stock at storage/picking location
  DISPATCH // - stock at dispatch/staging (order left the building)
  RETURN_IN // + stock at returns location
  ADJUSTMENT // +/- manual correction, always requires a reason
}

model StockMovement {
  id            String       @id @default(uuid())
  warehouseId   String
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])
  skuId         String
  sku           Sku          @relation(fields: [skuId], references: [id])
  locationId    String
  location      Location     @relation(fields: [locationId], references: [id])
  quantity      Decimal // signed: positive = stock in, negative = stock out
  movementType  MovementType
  referenceType String // e.g. "InboundReceiptLine", "PickTask", "Dispatch"
  referenceId   String // id of the row that caused this movement
  notes         String?
  createdById   String
  createdBy     User         @relation("MovementCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([skuId, locationId])
  @@index([warehouseId])
}

// ------------------------------------------------------------
// YARD & GATE MANAGEMENT
// ------------------------------------------------------------
// Foundation pass (2026-08-25) — Dock Door master data + the vehicle Gate
// In/Out log. This is deliberately the first slice of the roadmap's five-part
// Yard & Gate stage: Yard (parking-bay holding while a vehicle waits for a
// door) and Dock Scheduling (advance appointment booking) are consciously
// deferred, not scaffolded — see CLAUDE.md's Yard & Gate section.
//
// DockDoor and VehicleGateEntry are deliberately NOT linked to each other —
// an earlier draft gave VehicleGateEntry an optional dockDoorId with the
// system auto-flipping the door's status on assignment/gate-out. Rejected
// by the client (2026-08-25): Dock Door status is a manual, staff-driven
// action in practice, and real dock *selection* logic (which vehicle gets
// which door, and when) needs its own proper design pass later — not a
// side-effect of the gate log. Don't reintroduce this link without
// re-confirming the actual workflow first.

// What a dock door can be used for. BOTH is the common case for a small
// facility with no dedicated inbound/outbound doors.
enum DockDoorType {
  INBOUND
  OUTBOUND
  BOTH
}

enum DockDoorStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model DockDoor {
  id          String         @id @default(uuid())
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  code        String // physical door number/label, e.g. "D01"
  name        String?
  dockType    DockDoorType   @default(BOTH)
  status      DockDoorStatus @default(AVAILABLE)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  // A dock's own default unloading spot (2026-08-27, live-testing follow-up
  // — "we still need to set the staging area against each dock"). Revisits
  // the dock-to-staging mapping idea originally rejected as premature back
  // when Inbound receiving first shipped (assignedDockNumber on
  // VehicleGateEntry was, and still is, free text, not a real DockDoor
  // link — that decision is untouched by this field). This is deliberately
  // ONE default Location per dock, not a candidate list — a simple
  // suggestion Match Order pre-fills client-side (by string-matching the
  // gate entry's free-text assignedDockNumber against this DockDoor's own
  // code) but staff can still override. Optional — an unmapped dock just
  // leaves Match Order's staging field blank, exactly like today.
  defaultStagingLocationId String?
  defaultStagingLocation   Location? @relation(fields: [defaultStagingLocationId], references: [id])

  distances DockLocationDistance[]

  @@unique([warehouseId, code])
}

// Dock <-> Location travel distance (2026-08-27, Inbound deep-dive
// conversation) — schema-only for now, per the client's own "schema now,
// logic during the picking/putaway logic" framing: the actual
// dock-suggestion algorithm ("which dock keeps movement lowest for this
// order's putaway/pick locations") is deliberately NOT built this pass —
// it plugs in once Putaway (inbound) / Picking (outbound) logic exists to
// consume it. No endpoint, no import/entry UI exists yet either — the
// client explicitly chose the finest granularity (per real Location, not
// per Aisle/Section) and real measured meters (not a rank/priority number),
// which for a warehouse of any size means a large number of rows with no
// tooling to bulk-populate them yet; that data-entry tooling is left for
// when the consuming logic actually gets built, same as this project's
// other schema-now/logic-later pieces (ASN, SelfCheckInRequest).
model DockLocationDistance {
  id             String   @id @default(uuid())
  dockDoorId     String
  dockDoor       DockDoor @relation(fields: [dockDoorId], references: [id])
  locationId     String
  location       Location @relation(fields: [locationId], references: [id])
  distanceMeters Decimal
  createdAt      DateTime @default(now())

  @@unique([dockDoorId, locationId])
}

// Platform-level reference data (like ProductCategory — no companyId, not
// client-editable via any UI yet since SUPER_ADMIN account creation still
// doesn't exist; seeded directly by us so every company's Gate In vehicle-
// type dropdown draws from the same curated list). Dimensions are stored as
// three separate numeric columns, not a combined text label, specifically
// for future truck-load/volume analysis (2026-08-25 design conversation) —
// same "one field per dimension" convention as WarehouseStorageType's
// lengthM/widthM/heightM and CategoryPackSpec's lengthCm/widthCm/heightCm.
// `maxTonnage` is the payload ceiling, in Tons — deliberately a single
// number (not a min/max range) so it can be compared directly against a
// weighbridge reading later. List curated with the client 2026-08-25 —
// Indian mini-truck-through-40ft-container segments only; deliberately
// excludes two/three-wheelers and non-standard bodies (Low-Bed Trailer,
// Flatbed, Curtain-Sided, generic Multi-Axle open truck) where no reliable
// sourced dimension was found — see CLAUDE.md for the full list-building
// conversation and sourcing.
model VehicleType {
  id         String  @id @default(uuid())
  name       String  @unique // e.g. "Tata Ace / Chhota Hathi", "32 ft MXL"
  segment    String // Mini Truck | Pickup | MCV | HCV | Container
  lengthFt   Decimal
  widthFt    Decimal
  heightFt   Decimal
  maxTonnage Decimal

  // Optional generic detention cost, ₹ per 24 hours, for this vehicle class
  // (2026-08-27 — a 40ft container costs more in detention than a
  // mini-truck) — revised same day to a secondary/optional tier, not the
  // primary input: most companies just want one flat company-wide rate
  // (Company.detentionCostPerDay), this is for a company that later wants
  // to get more granular per vehicle class. Resolution order in
  // YardService.tracker() is Vehicle -> VehicleType -> Company. Nullable —
  // unset means this class just falls through to the company default.
  detentionCostPerDay Decimal?

  vehicles Vehicle[]
}

// Registered vehicle master — a tenant master (unlike VehicleType above),
// scoped per company like Warehouse/SKU/Customer. Added 2026-08-25 once the
// document-check conversation made clear a recurring vehicle (same truck
// showing up again and again) shouldn't need its RC/Insurance/PUC/Fitness
// re-typed at every single gate entry — register it once here instead.
// Registration is a deliberate, separate step — Gate In always picks an
// EXISTING Vehicle, it never creates one inline (confirmed with the client;
// an earlier idea to auto-create on an unrecognized vehicle number was
// rejected).
model Vehicle {
  id            String      @id @default(uuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  vehicleNumber String
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])

  // Actual measured dimensions of THIS specific vehicle, nullable — when
  // known, these override VehicleType's generic segment dimensions for any
  // load/volume calculation; when the registrar doesn't know them, callers
  // fall back to VehicleType's own lengthFt/widthFt/heightFt instead. Not
  // derived/computed — genuinely optional real-world data that may or may
  // not have been measured for a given truck.
  lengthFt Decimal?
  widthFt  Decimal?
  heightFt Decimal?

  // Actual registered max payload capacity for THIS specific vehicle, in
  // Tons — same override-when-known/fallback-to-VehicleType-otherwise
  // pattern as the dimensions above. Added 2026-08-27 specifically so the
  // Gate Out overweight check compares an outbound load against the real
  // truck's registered capacity, not just its generic segment ceiling.
  maxTonnage Decimal?

  // Optional per-vehicle override — same "override when known" pattern as
  // maxTonnage/dimensions above, for a specific truck on a specific
  // contract rate. Most companies won't set this at all and just rely on
  // Company.detentionCostPerDay's flat rate (revised same day, 2026-08-27)
  // — this and VehicleType's own rate are secondary refinement tiers for a
  // company that wants more granularity later. Detention cost accrues past
  // Company.detentionFreeHours's grace period — always computed live
  // (Vehicle -> VehicleType -> Company, YardService.tracker()), never
  // stored, same "always derive" philosophy as on-hand
  // stock/capacity.
  detentionCostPerDay Decimal?

  rcNumber        String?
  rcExpiry        DateTime?
  insuranceNumber String?
  insuranceExpiry DateTime?
  pucNumber       String?
  pucExpiry       DateTime?
  fitnessNumber   String?
  fitnessExpiry   DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Security-relevant bar-from-entry flag, confirmed needed 2026-08-25 —
  // same simple "flag + reason" shape as elsewhere in this codebase rather
  // than a full audit trail (who/when isn't tracked, matching the existing
  // isActive convention).
  isBlacklisted   Boolean @default(false)
  blacklistReason String?

  gateEntries     VehicleGateEntry[]
  inboundReceipts InboundReceipt[]

  @@unique([companyId, vehicleNumber])
}

// Registered driver master, same "register once, reuse" reasoning and
// company scoping as Vehicle above — added the same day once it became
// clear a Driving License belongs to the PERSON, not the vehicle (the same
// truck can show up with a different driver trip to trip), so it can't
// live on the Vehicle record. No unique constraint on phone/licenseNumber
// (deliberate, 2026-08-25) — unlike Vehicle's plate number, neither is a
// reliable-enough natural key to hard-enforce uniqueness on yet; a gate
// operator selects/searches an existing Driver manually rather than the
// system matching on one of these fields automatically.
model Driver {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  name          String
  phone         String?
  licenseNumber String?
  licenseExpiry DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  // Same bar-from-entry flag as Vehicle.isBlacklisted, confirmed needed for
  // both 2026-08-25.
  isBlacklisted   Boolean @default(false)
  blacklistReason String?

  gateEntries VehicleGateEntry[]
}

// Why the vehicle is at the gate — captured at Gate In (not deferred to dock
// assignment) so security can route it correctly from the moment it arrives.
// A fourth value, VEHICLE_ONLY (a non-cargo visit), was considered and
// dropped 2026-08-25 — no concrete real use case for it, easy to add back
// later if one shows up.
enum GateEntryPurpose {
  INBOUND_DELIVERY
  OUTBOUND_DISPATCH
  RETURNS
}

// Real-world parking/holding spot while a vehicle waits — one row per
// physical slot, generated from Warehouse.yardCapacity at warehouse
// creation (2026-08-25 Yard Management design conversation). Deliberately
// real, individually-addressable rows (not just a capacity counter) per the
// client's explicit call — even though day-to-day usage is "grab whichever
// slot's free," not manually picking one by code. `status` is auto-flipped
// by gate-entry logic (occupy on Gate In, free again later) — unlike
// DockDoor, where the equivalent auto-flip idea was explicitly REJECTED;
// Yard is a deliberately different, confirmed case, not the same mistake
// repeated.
enum YardSlotStatus {
  AVAILABLE
  OCCUPIED
}

model YardSlot {
  id          String         @id @default(uuid())
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  code        String // e.g. "Y1", "Y2"...
  status      YardSlotStatus @default(AVAILABLE)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  gateEntries VehicleGateEntry[]

  @@unique([warehouseId, code])
}

// The real trigger for freeing a slot is meant to be "vehicle moved to a
// dock," not Gate Out — but that requires the Dock Scheduling/assignment
// link this pass deliberately doesn't build yet (see DockDoor's comment on
// why Gate Entry <-> Dock Door stays unlinked for now). Until that exists,
// GateEntriesService releases the slot at Gate Out instead, as an explicit,
// documented placeholder — re-wire this to release on dock-in once that
// link is built, per the client's own framing ("it will be linked when we
// develop that").
enum GatePassDirection {
  INBOUND
  OUTBOUND
}

// The human-facing sequential number handed to a driver (VehicleGateEntry.
// gatePassNo), tracked separately per warehouse AND per direction (Inbound
// vs Outbound never share a counter) — confirmed 2026-08-25. `periodKey`'s
// shape depends on the company's own GatePassResetPeriod at the time it was
// computed (a financial year like "2026-27", a financial-year quarter like
// "2026-Q2", or a calendar month like "2026-08") — a fresh key naturally
// starts a fresh sequence, so no separate "reset" operation is needed.
model GatePassSequence {
  id          String            @id @default(uuid())
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  direction   GatePassDirection
  periodKey   String
  lastNumber  Int               @default(0)

  @@unique([warehouseId, direction, periodKey])
}

model VehicleGateEntry {
  id              String           @id @default(uuid())
  warehouseId     String
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  vehicleId       String
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id])
  driverId        String
  driver          Driver           @relation(fields: [driverId], references: [id])
  // Transporter can genuinely vary trip to trip even for the same
  // registered vehicle (a market/attached vehicle hired by different
  // transport companies) — deliberately stays free text per entry, not
  // moved onto the Vehicle master.
  transporterName String?
  purpose         GateEntryPurpose
  // Free-text PO/ASN/order reference — there's no real Inbound/Outbound
  // record to link to yet (those modules don't exist), same "landing spot
  // for later" reasoning as Sku/Warehouse/Customer's erpCode fields.
  referenceNo     String?
  // Plain city name, single value — a deliberately simplified reintroduction
  // of "Destination" (2026-08-25, Yard Management conversation) after the
  // original multi-point/Customer-Ship-to version was scrapped as overkill.
  // No FK, no multi-drop modeling — just visibility on the yard tracking
  // table for now.
  destinationCity String?

  // Auto-assigned from the warehouse's free YardSlot pool at Gate In —
  // never picked manually. Nullable because a slot may not exist to assign
  // (yard full and Company.blockGateInWhenYardFull is off, so the entry
  // still goes through with a "yard full" warning instead of a hard block).
  yardSlotId String?
  yardSlot   YardSlot? @relation(fields: [yardSlotId], references: [id])

  // Sequential, human-facing gate pass number — generated once at Gate In
  // via GatePassSequence, never changes after. Nullable only because it's
  // system-generated after validation, not client-supplied.
  gatePassNo String?

  gateInAt   DateTime @default(now())
  gateInById String
  gateInBy   User     @relation("GateInBy", fields: [gateInById], references: [id])

  gateOutAt   DateTime?
  gateOutById String?
  gateOutBy   User?     @relation("GateOutBy", fields: [gateOutById], references: [id])

  // A deliberately lightweight stand-in for real Dock Scheduling (not built
  // yet, 2026-08-25) — just "this vehicle left the yard," no dock door
  // selection or appointment logic. Frees the assigned YardSlot the moment
  // this is set. Elapsed yard time is never stored — always derived as
  // `dockedInAt - gateInAt` (or `NOW - gateInAt` while still ongoing) at
  // read time, same "always derive" philosophy as net weight/capacity.
  dockedInAt   DateTime?
  dockedInById String?
  dockedInBy   User?     @relation("DockedInBy", fields: [dockedInById], references: [id])

  // Dock assignment → driver notification (2026-08-27) — the missing piece
  // of "how does the driver know which dock to go to." Deliberately free
  // text, not a link to DockDoor — this field is just capturing the OUTPUT
  // of the real Dock Scheduler (not built yet, still fully deferred), typed
  // in by hand by a Security Supervisor standing in for that system. Setting
  // or changing it immediately fires an SMS + automated voice call to the
  // Driver's own phone (DriverNotificationService, yard-gate module) — see
  // DriverDockNotification below for the audit trail. dockAssignedAt drives
  // the two-stage warning timer (15 min initial, another 15 min final
  // warning, then nothing further automated — actually reassigning the dock
  // to the next vehicle after that is explicitly the future Dock
  // Scheduler's job, not built here) and resets on every reassignment.
  assignedDockNumber      String?
  dockAssignedAt          DateTime?
  driverDockNotifications DriverDockNotification[]

  // E-Way Bill — for an Outbound Dispatch, generated by us AFTER loading,
  // right before the truck leaves, so it's captured here at Gate Out.
  // (An Inbound Delivery's E-Way Bill was already generated by the sender
  // before the truck ever arrived — that's an incoming document, not
  // something Gate Out produces, and isn't modeled yet.) Whether Gate Out
  // is actually BLOCKED without this depends on
  // Company.requireEwayBillForOutboundGateOut — not every client routes
  // E-Way Bill data through this system.
  eWayBillNo          String?
  eWayBillGeneratedAt DateTime?

  // Inbound's Gate Out closing condition isn't an E-Way Bill at all — it's
  // "all material has been received/scanned." Since Inbound/Receiving
  // doesn't exist as a module yet, this is a plain manual tick for now
  // (set true only alongside Gate Out itself — gateOutAt/gateOutById above
  // already capture who/when, so no separate timestamp needed here), to be
  // replaced by a real system-driven check once Inbound is built.
  materialReceivedConfirmed Boolean @default(false)

  // Overweight check for Outbound Dispatch only — this is the client's own
  // KPI (2026-08-27). Real total should eventually be computed as
  // SUM(OutboundOrderLine.orderedQty * Sku.grossWeight) once a real
  // Outbound/Invoice module exists (that schema — Sku.grossWeight,
  // OutboundOrderLine — already exists and needs no further changes for
  // this). Until then, this is a plain manual entry at Gate Out, same
  // "dummy for now" pattern as dockedInAt. Compared against
  // Vehicle.maxTonnage (falling back to VehicleType.maxTonnage) — over that
  // ceiling blocks Gate Out entirely, it's not just a warning. The
  // comparison itself is never stored, only this raw input — always
  // re-derived against whatever the vehicle's current registered capacity
  // is at read time.
  invoiceWeightKg Decimal?

  // Weight Bridge — real manual entry (not just an integration hook like
  // erpCode): an operator types the gross and tare readings in directly.
  // Net weight is always derived (gross - tare) at read time, never stored
  // — same "always derived" philosophy as Location capacity / on-hand stock.
  grossWeightKg  Decimal?
  grossWeighedAt DateTime?
  tareWeightKg   Decimal?
  tareWeighedAt  DateTime?

  documentChecks GateEntryDocumentCheck[]

  // Back-reference only — set when this entry was created by staff
  // confirming a SelfCheckInRequest rather than a normal Gate In. See that
  // model's comment for the full self-service check-in flow.
  selfCheckInRequest SelfCheckInRequest?

  // Cargo/commodity description — free-text, useful for basic visibility
  // before a real Inbound/Outbound module exists to carry SKU-level detail
  // (2026-08-27, Yard/Gate competitor-research follow-up — see
  // wms-yms-competitor-research memory). Captured at Gate In, either
  // direction.
  commodityDescription String?

  // Physical condition inspection — separate from GateEntryDocumentCheck's
  // paperwork checks: this is about the truck/trailer's own physical state
  // (dents, tyres), not document validity. Deliberately flat (no photos, no
  // itemized checklist) — the client's own call, "not mature enough to take
  // in photos yet." Captured once, alongside Dock In (dockIn()) for BOTH
  // directions — there's no separate "loading start" event in this system
  // to hang it off instead, and Dock In is the natural "about to
  // load/unload" moment.
  physicalConditionOk      Boolean?
  physicalConditionRemarks String?

  // Seal number + signature — cheap dispute-resolution fields ("was the
  // seal intact when it left/arrived"). Timing differs by purpose, same
  // "purpose decides what's captured at each step" pattern eWayBillNo/
  // materialReceivedConfirmed already use: for INBOUND_DELIVERY, captured
  // at Dock In (the seal the truck arrived with, checked before unloading);
  // for OUTBOUND_DISPATCH, captured at Gate Out (sealed right after
  // loading — same moment the E-Way Bill is generated, "dock out" in the
  // client's own words but this system has no separate Dock Out event, so
  // it lands on the existing Gate Out step, same as E-Way Bill does).
  // sealSignatureData is a base64 PNG from a simple canvas signature pad —
  // no separate asset/blob storage exists in this project, so a plain text
  // column is enough for one small image.
  sealNumber        String?
  sealSignatureData String?
  sealCapturedAt    DateTime?
  sealCapturedById  String?
  sealCapturedBy    User?     @relation("SealCapturedBy", fields: [sealCapturedById], references: [id])

  // The real, authoritative order match (2026-08-27, Inbound receiving
  // design) — set at a NEW step after Dock In, distinct from the loose
  // free-text `referenceNo` above captured at Gate In. @unique so a given
  // InboundReceipt can only ever be claimed by one gate visit. Nullable
  // because most of a gate entry's life happens before this step runs (and
  // Outbound entries never set it at all — this only applies to Inbound
  // receiving).
  inboundReceiptId String?              @unique
  inboundReceipt   InboundReceipt?      @relation(fields: [inboundReceiptId], references: [id])
  inboundScans     InboundReceiptScan[]

  // A deliberate human close-out, distinct from the receipt simply reaching
  // RECEIVED status (2026-08-27, a real gap the client caught testing the
  // flow themselves: reaching RECEIVED was auto-unlocking Gate Out with no
  // explicit sign-off). "Complete Inward Process" — enabled only once the
  // matched order is fully RECEIVED — stamps who/when and captures an
  // optional remarks note (e.g. "one case damaged, noted separately").
  // gateOut() for INBOUND_DELIVERY now requires THIS to be set, not just
  // the receipt's own status.
  inwardCompletedAt       DateTime?
  inwardCompletedById     String?
  inwardCompletedBy       User?     @relation("InwardCompletedBy", fields: [inwardCompletedById], references: [id])
  inwardCompletionRemarks String?

  createdAt DateTime @default(now())

  @@index([warehouseId, gateInAt])
}

enum DockNotificationStage {
  INITIAL
  FINAL_WARNING
}

// The audit trail for VehicleGateEntry.assignedDockNumber's driver
// notifications (2026-08-27) — deliberately separate from NotificationLog
// (which is for staff/User recipients only): a Driver isn't a User, has no
// login, and is reached by phone (SMS + an automated voice call), not
// email. driverPhone is a snapshot of the number actually dialed/texted at
// the time — kept even if the Driver record's phone changes later, so this
// stays real proof of what was contacted. status only ever reaches
// SENT/FAILED here (reusing NotificationStatus from the staff-notification
// side rather than a redundant enum) — ACKNOWLEDGED doesn't apply, a driver
// has no way to acknowledge through this system. Whether the call was
// actually ANSWERED (vs just dialed) is an explicit later upgrade, not
// built now — the client's own call: "Dailed / Sent sms @ what time is
// what we need to start building now, answered/non answer is a later
// upgrade."
model DriverDockNotification {
  id           String                @id @default(uuid())
  gateEntryId  String
  gateEntry    VehicleGateEntry      @relation(fields: [gateEntryId], references: [id])
  stage        DockNotificationStage
  channel      NotificationChannel
  driverPhone  String
  message      String
  status       NotificationStatus    @default(PENDING)
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime              @default(now())

  @@index([gateEntryId, stage])
}

// What's checked at the gate — License/Insurance/RC/PUC/Fitness — against
// whatever's on file on the Vehicle/Driver master, one row per document type
// per entry (a gate entry can have several documents checked, same "more
// than one of, make it a child table" reasoning as SkuBarcode/
// CustomerShipTo). The document's actual number/expiry lives on Vehicle/
// Driver; this table only records the pass/fail judgment call made fresh at
// THIS visit (an otherwise-valid document could still get FLAGGED for a
// reason unrelated to its expiry, e.g. a torn/illegible copy).
enum GateDocumentType {
  LICENSE
  INSURANCE
  RC
  PUC
  FITNESS
}

enum GateDocumentStatus {
  OK
  FLAGGED
  MISSING
}

model GateEntryDocumentCheck {
  id           String             @id @default(uuid())
  gateEntryId  String
  gateEntry    VehicleGateEntry   @relation(fields: [gateEntryId], references: [id])
  documentType GateDocumentType
  status       GateDocumentStatus
  note         String?

  @@unique([gateEntryId, documentType])
}

// ------------------------------------------------------------
// NOTIFICATIONS & SELF-SERVICE CHECK-IN
// ------------------------------------------------------------

// 2026-08-27 design conversation: the client wants real capacity to notify
// by SMS, Email, or WhatsApp depending on what a given client company
// actually wants ("we need to have capacity to do all... depending on the
// client requirement"), not one hardcoded channel. This is schema +
// architecture only — no provider is actually wired up yet (no MSG91/
// Twilio/etc. API calls exist anywhere in this codebase). The first real
// trigger is detention alerting (Company.detentionAlertHours/
// detentionEscalationHours above); more event types get added to
// NotificationEventType the same way SECURITY_SUPERVISOR was added to Role
// (ALTER TYPE ... ADD VALUE) as they're actually built.
enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  // Added 2026-08-27 for driver dock-assignment notifications — an
  // automated call, not a message, genuinely different capability than the
  // three above (telephony, not messaging). See DriverDockNotification.
  VOICE_CALL
}

enum NotificationEventType {
  DETENTION_ALERT
  // Fires once at Gate In, only for INBOUND_DELIVERY, only when every
  // GateEntryDocumentCheck came back OK — to every WAREHOUSE_SUPERVISOR/
  // WAREHOUSE_MANAGER on that warehouse (2026-08-27, Inbound receiving
  // design). Same broadcast shape DETENTION_ALERT already uses.
  VEHICLE_READY_FOR_UNLOADING
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  ACKNOWLEDGED
}

// Per-company, per-channel configuration — a child table rather than flat
// booleans on Company, since a company can enable more than one channel at
// once (same "more than one of, make it a child table" rule as
// SkuBarcode/CustomerShipTo). senderId/fromAddress are the per-company
// identity a message goes out under (e.g. their own WhatsApp Business
// number); the actual provider API key/secret deliberately does NOT live
// here — that stays in environment config (same place JWT_SECRET lives),
// not the database, until this gets real encryption-at-rest. providerName
// is informational only for now (e.g. "MSG91").
model CompanyNotificationChannel {
  id           String              @id @default(uuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id])
  channel      NotificationChannel
  isEnabled    Boolean             @default(false)
  senderId     String?
  fromAddress  String?
  providerName String?

  @@unique([companyId, channel])
}

// The audit/delivery/escalation trail — one row per notification actually
// sent (or attempted). referenceType/referenceId is a free-text pointer
// (same pattern as StockMovement.referenceType) rather than a typed FK,
// since NotificationEventType is meant to grow beyond gate-entry-linked
// events (e.g. a future document-expiry alert would point at a Vehicle/
// Driver, not a VehicleGateEntry). acknowledgedAt is set when the
// recipient (a Manager) marks it seen; if that never happens within
// Company.detentionEscalationHours, escalatedAt/escalatedToId record that
// it also went to the Company Admin. message is the actual rendered text
// sent, kept for audit even once templates change later.
model NotificationLog {
  id                String                @id @default(uuid())
  companyId         String
  company           Company               @relation(fields: [companyId], references: [id])
  warehouseId       String?
  warehouse         Warehouse?            @relation(fields: [warehouseId], references: [id])
  eventType         NotificationEventType
  referenceType     String?
  referenceId       String?
  channel           NotificationChannel
  recipientUserId   String
  recipient         User                  @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  status            NotificationStatus    @default(PENDING)
  message           String
  sentAt            DateTime?
  acknowledgedAt    DateTime?
  escalatedAt       DateTime?
  escalatedToId     String?
  escalatedTo       User?                 @relation("NotificationEscalatedTo", fields: [escalatedToId], references: [id])
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime              @default(now())

  @@index([companyId, eventType, status])
}

enum SelfCheckInStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// 2026-08-27 — the client confirmed wanting self-service driver check-in
// eventually ("its a good addition"), basic schema now, real workflow
// logic customer-specific later. Deliberately isolated from Vehicle/
// Driver/VehicleGateEntry: a driver has no login/User account anywhere in
// this system, so this table exists specifically to hold a driver's own
// unverified, self-submitted claim (via a QR code or link, no auth) until
// a security guard reviews it. Only on ACCEPTED does it become a real
// VehicleGateEntry (resultingGateEntryId) — a raw self-submission never
// becomes an official record on its own.
model SelfCheckInRequest {
  id                   String            @id @default(uuid())
  companyId            String
  company              Company           @relation(fields: [companyId], references: [id])
  warehouseId          String
  warehouse            Warehouse         @relation(fields: [warehouseId], references: [id])
  vehicleNumberText    String
  driverNameText       String
  driverPhoneText      String?
  purpose              GateEntryPurpose?
  status               SelfCheckInStatus @default(PENDING)
  submittedAt          DateTime          @default(now())
  reviewedById         String?
  reviewedBy           User?             @relation("SelfCheckInReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  rejectionReason      String?
  resultingGateEntryId String?           @unique
  resultingGateEntry   VehicleGateEntry? @relation(fields: [resultingGateEntryId], references: [id])

  @@index([warehouseId, status])
}

// ------------------------------------------------------------
// INBOUND
// ------------------------------------------------------------

enum ReceiptStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  PUTAWAY_COMPLETE
}

model InboundReceipt {
  id           String        @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  referenceNo  String // e.g. supplier ASN / PO number
  supplierName String?
  status       ReceiptStatus @default(PENDING)
  // Nullable (2026-08-27, ERP push follow-up) — was required until an ERP
  // push needed to create a real order with no human on the other end.
  // Null is the signal "this came from ERP, not a person" — see
  // createdViaErpPush below for the same fact made explicit/queryable.
  createdById  String?
  createdBy    User?         @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  // True only for an order created via ErpInboundController's push
  // endpoint (2026-08-27) — lets the frontend show "ERP" instead of a
  // blank creator name, and is the more explicit/queryable twin of
  // `createdById` being null (which also means the same thing, but null
  // alone reads ambiguously — "unknown" vs. "genuinely no human").
  createdViaErpPush Boolean @default(false)

  // The one registered Vehicle this order is expected to arrive on
  // (2026-08-27, Inbound deep-dive follow-up) — required by the service
  // layer on every order created MANUALLY or via Excel import, same
  // "no DB constraint layer for business rules" convention as everywhere
  // else in this codebase (see CLAUDE.md's note on the missing DTO/
  // class-validator layer). Nullable here for two reasons: a handful of
  // pre-existing throwaway-company receipts created before this field
  // existed, and — a real, ongoing case, not just legacy data — an
  // ERP-pushed order (2026-08-27 follow-up), which by design never knows
  // vehicle details (that's a WMS-only concern, the client's own framing)
  // and is completed later via InboundReceiptsService.assignVehicle() once
  // staff actually know which truck it's coming on. Enforces a real 1:1
  // mapping once set: GateEntriesService.matchReceipt() no
  // longer takes a typed PO/Invoice number at all — it looks up the one
  // InboundReceipt for the gate entry's own vehicle that has no gateEntry
  // yet. InboundReceiptsService's create()/bulkImport() block creating a
  // second order for a vehicle that already has one such unmatched order
  // (a vehicle can make many trips over its life, just never two open
  // orders at once — enforced company-wide, not per-warehouse, since a
  // vehicle can only physically be in one place).
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  lines InboundReceiptLine[]
  scans InboundReceiptScan[]

  // Where this delivery gets staged, chosen once — at the Match Order step
  // after Dock In, when the vehicle is physically at the dock and staff
  // actually knows where they're unloading it (2026-08-27, a real gap the
  // client caught: staging location can't be known at order-creation time,
  // before the vehicle even exists in the system, and dock-to-staging
  // mapping was rejected as premature since Dock assignment is still free
  // text, not a real DockDoor link — see assignedDockNumber's comment).
  // Nullable until Match Order sets it; a per-line stagingLocationId below
  // still exists as an optional OVERRIDE for a SKU that genuinely needs a
  // different spot than the rest of the truckload, falling back to this
  // receipt-level default when unset (GateEntriesService.scan()).
  stagingLocationId String?
  stagingLocation   Location? @relation(fields: [stagingLocationId], references: [id])

  // The one VehicleGateEntry that matched against this receipt (2026-08-27,
  // Inbound receiving design) — set from the gate-entry side
  // (VehicleGateEntry.inboundReceiptId, @unique there), so a receipt can
  // only ever be claimed by one real gate visit. Nullable/no relation
  // fields needed here since Prisma infers the back-relation automatically
  // from the @unique FK on the other side.
  gateEntry VehicleGateEntry?
}

model InboundReceiptLine {
  id                String         @id @default(uuid())
  receiptId         String
  receipt           InboundReceipt @relation(fields: [receiptId], references: [id])
  skuId             String
  sku               Sku            @relation(fields: [skuId], references: [id])
  expectedQty       Decimal
  // Only ever incremented by an ACCEPTED or APPROVED InboundReceiptScan —
  // never edited directly. The per-line reconciliation this drives
  // (receivedQty vs expectedQty, checked per SKU, never blended into one
  // receipt-wide total) is the whole point of tracking it per line rather
  // than as one aggregate count on the receipt (2026-08-27 design
  // conversation).
  receivedQty       Decimal        @default(0)
  // Optional override of the receipt's own stagingLocationId (see that
  // field's comment) — most lines leave this unset and just use the
  // receipt-level default.
  stagingLocationId String?
  stagingLocation   Location?      @relation(fields: [stagingLocationId], references: [id])

  putawayTasks PutawayTask[]
  scans        InboundReceiptScan[]
}

// The full lifecycle of one scanned code during receiving (2026-08-27
// Inbound design). Every physical item gets scanned and captured here
// regardless of whether the system can automatically make sense of it —
// capture is universal, interpretation is tiered:
//   ACCEPTED  — barcode resolved cleanly via SkuBarcode/SkuStorageUnit to a
//               SKU+quantity that matched a real remaining expected line.
//               Posts a StockMovement immediately, no human touches it.
//   BLOCKED   — anything that didn't resolve cleanly: wrong SKU (not on
//               this receipt), would exceed that line's expectedQty, OR
//               the barcode simply couldn't be interpreted at all yet (a
//               composite case/GS1 barcode, a unique per-item serial — full
//               parsing of those is explicitly deferred, see CLAUDE.md).
//               skuId/receiptLineId/quantity stay null until a Supervisor
//               resolves it — the operator who scanned it cannot self-
//               approve, by design (their own confirmation).
//   APPROVED  — a Supervisor confirmed what it actually is (filling in
//               skuId/receiptLineId/quantity if they weren't already set)
//               and it now counts as received — permanently flagged in the
//               record as a reviewed override, never silently merged with
//               a clean ACCEPTED scan.
//   REJECTED  — a Supervisor discarded it as a genuine mistake (mis-scan,
//               duplicate) — no stock impact, stays in the log for audit.
enum InboundScanStatus {
  ACCEPTED
  BLOCKED
  APPROVED
  REJECTED
}

model InboundReceiptScan {
  id             String              @id @default(uuid())
  receiptId      String
  receipt        InboundReceipt      @relation(fields: [receiptId], references: [id])
  gateEntryId    String
  gateEntry      VehicleGateEntry    @relation(fields: [gateEntryId], references: [id])
  barcodeScanned String
  skuId          String?
  sku            Sku?                @relation(fields: [skuId], references: [id])
  receiptLineId  String?
  receiptLine    InboundReceiptLine? @relation(fields: [receiptLineId], references: [id])
  // The resolved quantity this one scan represents — 12 for a case
  // barcode, 1 for a single tyre, resolved via SkuBarcode.storageUnitId ->
  // SkuStorageUnit.qtyInBaseUom (defaults to 1/"each" when the barcode has
  // no storage unit linked). Null until resolved (BLOCKED, unresolved).
  quantity       Decimal?
  status         InboundScanStatus   @default(ACCEPTED)
  blockReason    String? // e.g. "Unrecognized barcode", "Not on this receipt", "Exceeds expected quantity"
  scannedById    String
  scannedBy      User                @relation("InboundScannedBy", fields: [scannedById], references: [id])
  scannedAt      DateTime            @default(now())
  reviewedById   String?
  reviewedBy     User?               @relation("InboundScanReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?

  @@index([receiptId])
  @@index([gateEntryId, status])
}

// ------------------------------------------------------------
// PUTAWAY
// ------------------------------------------------------------

enum PutawayStatus {
  PENDING
  COMPLETED
}

model PutawayTask {
  id             String             @id @default(uuid())
  receiptLineId  String
  receiptLine    InboundReceiptLine @relation(fields: [receiptLineId], references: [id])
  skuId          String
  sku            Sku                @relation(fields: [skuId], references: [id])
  fromLocationId String
  fromLocation   Location           @relation("PutawayFromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location           @relation("PutawayToLocation", fields: [toLocationId], references: [id])
  quantity       Decimal
  status         PutawayStatus      @default(PENDING)
  completedById  String?
  completedBy    User?              @relation("PutawayCompletedBy", fields: [completedById], references: [id])
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
}

// ------------------------------------------------------------
// OUTBOUND / ALLOCATION / PICKING / DISPATCH
// ------------------------------------------------------------

enum OrderStatus {
  CREATED
  ALLOCATED
  PICKING
  PICKED
  PACKED
  DISPATCHED
  CANCELLED
}

model OutboundOrder {
  id           String      @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse   @relation(fields: [warehouseId], references: [id])
  orderNo      String      @unique
  customerName String?
  status       OrderStatus @default(CREATED)
  createdById  String
  createdBy    User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())

  lines    OutboundOrderLine[]
  dispatch Dispatch?
}

model OutboundOrderLine {
  id           String        @id @default(uuid())
  orderId      String
  order        OutboundOrder @relation(fields: [orderId], references: [id])
  skuId        String
  sku          Sku           @relation(fields: [skuId], references: [id])
  orderedQty   Decimal
  allocatedQty Decimal       @default(0)
  pickedQty    Decimal       @default(0)

  allocations Allocation[]
}

enum AllocationStatus {
  ALLOCATED
  PICKED
  CANCELLED
}

model Allocation {
  id          String            @id @default(uuid())
  orderLineId String
  orderLine   OutboundOrderLine @relation(fields: [orderLineId], references: [id])
  skuId       String
  sku         Sku               @relation(fields: [skuId], references: [id])
  locationId  String
  location    Location          @relation(fields: [locationId], references: [id])
  quantity    Decimal
  status      AllocationStatus  @default(ALLOCATED)
  createdAt   DateTime          @default(now())

  pickTask PickTask?
}

enum PickStatus {
  PENDING
  PICKED
}

model PickTask {
  id           String     @id @default(uuid())
  allocationId String     @unique
  allocation   Allocation @relation(fields: [allocationId], references: [id])
  pickerId     String?
  picker       User?      @relation("PickedBy", fields: [pickerId], references: [id])
  quantity     Decimal
  status       PickStatus @default(PENDING)
  pickedAt     DateTime?
  createdAt    DateTime   @default(now())
}

model Dispatch {
  id             String        @id @default(uuid())
  orderId        String        @unique
  order          OutboundOrder @relation(fields: [orderId], references: [id])
  dispatchedById String
  dispatchedBy   User          @relation("DispatchedBy", fields: [dispatchedById], references: [id])
  carrier        String?
  trackingNo     String?
  dispatchedAt   DateTime      @default(now())
}

// ------------------------------------------------------------
// RETURNS
// ------------------------------------------------------------

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  CUSTOMER_CHANGED_MIND
  QUALITY_ISSUE
  OTHER
}

model Return {
  id              String       @id @default(uuid())
  originalOrderNo String? // reference to the outbound order, kept as text for simplicity in MVP
  skuId           String
  sku             Sku          @relation(fields: [skuId], references: [id])
  quantity        Decimal
  reason          ReturnReason
  locationId      String
  location        Location     @relation(fields: [locationId], references: [id])
  createdAt       DateTime     @default(now())
}
